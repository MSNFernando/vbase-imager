<?xml version="1.0" encoding="utf-8"?>
<!--
  vBase Imager, Windows: the self-contained vbase-imager.exe (7-Zip's 7zSD.sfx module with the
  app's files appended), uploaded by GitHub Actions as a zip holding that one file. Proposed for
  the SignPath project as the artifact configuration "exe" (the workflow's default slug for it);
  the programs inside were already signed by the "default" configuration before being packed.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="vbase-imager.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
