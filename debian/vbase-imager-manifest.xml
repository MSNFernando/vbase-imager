<?xml version="1.0" encoding="UTF-8"?>
<!-- MIME type for vBase Imager manifest files.
     Extension and MIME type defined in src/config.h (MANIFEST_EXTENSION, MANIFEST_MIME_TYPE) -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/vnd.onecomet.vbase-imager-manifest+json">
    <comment>vBase Imager Manifest</comment>
    <comment xml:lang="zh_CN">树莓派启动盘制作工具清单</comment>
    <glob pattern="*.vbase-imager-manifest"/>
    <sub-class-of type="application/json"/>
    <icon name="vbase-imager"/>
  </mime-type>
</mime-info>

