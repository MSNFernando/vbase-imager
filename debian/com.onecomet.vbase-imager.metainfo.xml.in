<?xml version="1.0" encoding="UTF-8" ?>
<component type="desktop-application">
  <id>com.onecomet.vbase-imager</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>
  <name>vBase Imager</name>
  <summary>Write the vBase installer image to a USB stick</summary>
  <description>
    <p>
      vBase Imager lists the vBase installer releases published at
      github.com/MSNFernando/vbase-releases, downloads the one you choose,
      checks its SHA-256 and writes it to a USB stick, then reads the stick
      back to verify it.
    </p>
    <p>
      It is a modified fork of an Apache-2.0 licensed open-source imaging
      utility; see the NOTICE file for details.
    </p>
  </description>
  <launchable type="desktop-id">vbase-imager.desktop</launchable>
  <url type="homepage">https://github.com/MSNFernando/vbase-imager</url>
  <provides>
    <binary>vbase-imager</binary>
  </provides>
  <releases>
    <release version="@IMAGER_VERSION_STR@" />
  </releases>
  <content_rating type="oars-1.1">
    <content_attribute id="social-info">moderate</content_attribute>
  </content_rating>
</component>

